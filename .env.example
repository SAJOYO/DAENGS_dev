# docker-compose.yml 이 읽는 값입니다.
# 이 파일을 .env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# ⚠ 서버 PC 전용입니다. compose 는 서버 PC 에서만 띄웁니다 — 개발 PC 에서는
# 이 파일이 필요 없습니다. 개발 PC 접속 정보는 backend/.env.example 을 보세요.
#
# backend 설정은 여기가 아니라 backend/.env 에 있습니다.

# ── Postgres (pgvector) ───────────────────────────────────────────
# ⚠ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 는 db/init/ 과 마찬가지로
#   **볼륨이 비어 있을 때 한 번만** 반영됩니다. 이미 만들어진 볼륨에서 이 값을
#   바꾸면 DB 안의 계정은 그대로라 backend 가 인증에 실패합니다.
#   이미 돌고 있는 DB 의 계정을 바꾸려면 psql 로 직접 하세요:
#     docker compose exec -it pgvector psql -U postgres
#     \password <계정>            (비밀번호 변경. 화면·히스토리에 안 남습니다)
#
# DB 가 있는 장비의 LAN IP. compose 가 읽는 값은 아니고, '팀 DB 가 어디인지'를
# 한 곳에 적어 두는 용도입니다. 개발 PC 에서 붙을 때 이 값을 backend/.env 의
# DAENGS_DB_HOST 에 넣으세요. 서버 PC 자신은 compose 네트워크로 붙으므로 안 씁니다.
POSTGRES_IP=
POSTGRES_USER=postgres
# 5432 를 LAN 에 열어 두는 구성이라 기본값을 그대로 쓰지 마세요.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb
# 호스트에 노출할 포트. 이미 5432 를 쓰고 있으면 바꾸세요.
POSTGRES_PORT=5432

# ── Redis (실시간 산책 ②) ─────────────────────────────────────────
# 값 캐시 · 일 예산 카운터 · 활성 키 집합을 담습니다 (RT-001 ④ · D-019).
#
# ⚠ **REDIS_PASSWORD 를 반드시 채우세요.** Postgres 와 달리 Redis 는 기본이
#   무인증이고, 이 구성은 포트를 LAN 에 엽니다 (개발 PC 에서도 서버 Redis 에 붙어야
#   data.go.kr 의 일 1,000회 카운터가 하나로 모이기 때문입니다). 비워 두면 같은
#   네트워크의 누구나 붙어서 FLUSHALL 할 수 있습니다.
#
# ⚠ **영숫자로만 지으세요.** DB 접속 정보와 달리 Redis 는 URL 한 줄로 넘어가서
#   (backend/.env 의 REDIS_URL, compose 의 같은 이름) @ / # 이 들어가면 깨집니다.
#   조각으로 받는 DAENGS_DB_* 와 다른 점입니다 (D-013 이 피하려던 바로 그 함정).
#
#   uv run python -c "import secrets; print(secrets.token_hex(24))"
#
# ⚠ **서버 .env 에 먼저 넣고 배포하세요.** 비어 있는 채로 컨테이너가 뜨면
#   인증 없는 Redis 가 LAN 에 열립니다.
#
# 볼륨이 빌 때만 반영되는 POSTGRES_* 와 달리 이 값은 재기동하면 바로 바뀝니다.
# 대신 바꾸면 개발 PC 들의 backend/.env 에 있는 REDIS_URL 도 같이 고쳐야 합니다.
REDIS_PASSWORD=
# 호스트에 노출할 포트. 이미 6379 를 쓰고 있으면 바꾸세요.
REDIS_PORT=6379

# ── pgAdmin (docker compose --profile tools up -d 일 때만) ────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ---- Training RAG (backend container -> host-side separate FastAPI) -------
# Training RAG의 PGVector(기본 5433/dog_rag)와 DAENGS pgvector(5432/vectordb)는 별개입니다.
# 서비스 주소는 코드에 넣지 않고 서버 .env에서만 설정합니다.
DAENGS_TRAINING_RAG_BASE_URL=http://host.docker.internal:8010
