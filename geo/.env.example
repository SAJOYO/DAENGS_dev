DAENGS_DATABASE_URL=postgresql+asyncpg://daengs:daengs@localhost:5432/daengs
# /dev 검증 콘솔. 코드 기본값은 false — 콘솔은 개발 표면이라 켜는 쪽이 명시한다.
DAENGS_DEV_CONSOLE=true             # true | false (코드 기본값 false)
# 실제 NAVER/TMAP/OpenAI를 로컬에서 검증할 때만 켠다. 같은 Gate 안에서 요청·시간당 한도가 적용된다.
DAENGS_USAGE_POLICY=dev             # dev | deny-all (코드 기본값 deny-all)
# 실제 지도 표면만 먼저 네이버로 고정한다. Dynamic Map + Static Map을 같은 key id로 쓴다.
# 키가 없거나 SDK 로드에 실패하면 /dev는 개발용 OSM으로 내려간다.
# Web 서비스 URL 불일치는 NAVER가 실패 타일을 그릴 수 있으므로 등록 호스트와 접속 호스트를 맞춘다.
DAENGS_MAP_PROVIDER=naver         # naver | none
DAENGS_STATIC_MAP_PROVIDER=naver
DAENGS_GEOCODE_PROVIDER=none      # 좌표 복구/지오코딩은 현재 범위 밖
DAENGS_KAKAO_REST_KEY=
DAENGS_NAVER_NCP_KEY_ID=
DAENGS_NAVER_NCP_KEY=
DAENGS_WEB_MAP_BASE=https://daengs.example/map

# 경로 (모드별). 도보 장애물은 tmap만.
#   none = 이 수단을 안 쓴다 (응답에 status=unavailable, 숫자 없음)
#   fake = 개발용 계산식. 실측을 요청해도 status=estimate 다 (measured 는 진짜 제공사만)
# 구현 안 된 조합(car=kakao 등)은 서버가 시작할 때 거른다.
DAENGS_WALK_ROUTE_PROVIDER=fake     # tmap | fake | none
DAENGS_CAR_ROUTE_PROVIDER=fake      # fake | none  (kakao·naver 자동차 미구현)
DAENGS_TRANSIT_ROUTE_PROVIDER=fake  # fake | none  (실측 제공사 없음)
DAENGS_TMAP_APP_KEY=

# LLM (utterance 있을 때만)
DAENGS_LLM_PROVIDER=fake            # fake | openai
DAENGS_OPENAI_API_KEY=

# 행정안전부 동물병원/동물약국 인허가 데이터 (data.go.kr 일반/Decoding 인증키)
DAENGS_DATA_GO_KR_SERVICE_KEY=

# 한국관광공사 반려동물 동반여행 (data.go.kr 일반/Decoding 인증키)
DAENGS_KTO_SERVICE_KEY=
