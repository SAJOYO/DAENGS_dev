# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 gitignore 대상입니다.
# dry-run 모드(--dry-run)와 로컬 검색 평가(run_combined_retrieval_eval.py)는
# 아래 값 없이도 실행됩니다.

# scripts/collect_youtube_metadata.py — YouTube Data API v3 키
YOUTUBE_API_KEY=

# scripts/collect_youtube_metadata.py — 채널 handle. 생략 시 기본값 Bodeumofficial 사용
YOUTUBE_CHANNEL_HANDLE=

# scripts/extract_entities.py, scripts/generate_answers.py — 실 API 호출(비-dry-run) 시 필요
OPENAI_API_KEY=

# scripts/run_openai_generation_experiment.py (소규모 생성 기준선)
# 비워 두면 기본값 gpt-5-mini를 사용합니다.
OPENAI_GENERATION_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal

# 로컬 기본 생성기 (Ollama가 localhost:11434에서 실행 중이어야 합니다)
GENERATION_MODE=ollama
OLLAMA_GENERATION_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# scripts/rag_api.py — POST /chat API
# 공용 Docker/다른 PC로 옮길 때 이 DSN만 대상 서버에 맞게 바꾸면 됩니다.
RAG_PGVECTOR_DSN=postgresql://dog_rag:dog_rag_local@localhost:5433/dog_rag
# 쉼표로 구분. 운영 도메인을 추가하고 와일드카드는 사용하지 않습니다.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# scripts/load_graph_neo4j.py — 실제 Neo4j 적재(비-dry-run) 시 필요. URI·사용자명은
# --uri/--user CLI 옵션으로 지정하며(기본값 bolt://localhost:7687, neo4j), 이 값만
# .env에서 읽습니다
NEO4J_PASSWORD=
