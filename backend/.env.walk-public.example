# Copy outside the server checkout and set WALK_PUBLIC_ENV_FILE in root .env.
# Use server-only values. Do not put this file into an app build.
DAENGS_WALK_SGIS_KEY=
DAENGS_WALK_SGIS_SECRET=
DAENGS_WALK_PUBLIC_DATA_KEY=
DAENGS_WALK_PARK_CATALOG_PATH=/data/walk-public/parks.json
DAENGS_WALK_COMMERCE_CATALOG_PATH=/data/walk-public/commerce.json
DAENGS_WALK_RIVER_CATALOG_PATH=/data/walk-public/river.json
DAENGS_WALK_PUBLIC_CATALOG_ROOT=/data/walk-public/regions
DAENGS_WALK_CATALOG_REFRESH_ENABLED=false
# Automatic refresh only: individual HTTP pages, including failures, share this daily cap.
DAENGS_WALK_CATALOG_DAILY_REQUESTS=300
# Prepare/Check first. The explicit Start action enables these flags after preparation.
DAENGS_WALK_ENTRY_CONTEXT_ENABLED=false
DAENGS_WALK_PUBLIC_CONTEXT_ENABLED=false
DAENGS_WALK_AREA_CONTEXT_ENABLED=false
DAENGS_WALK_DIARY_ENABLED=false
# Independent scene normalization (commerce / parks / land cover), after catalog refresh.
DAENGS_WALK_DIARY_SPACE_ENABLED=false
DAENGS_WALK_DIARY_ROUTE_PATTERNS_ENABLED=false
DAENGS_WALK_DIARY_SPACE_RADIUS_M=1000
DAENGS_WALK_LAND_COVER_LAYER=EGIS:lv3_2025y
# Start also enables v2 reads/writes and photo metadata; apply their SQL before Start.
