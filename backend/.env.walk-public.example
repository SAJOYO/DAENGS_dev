# Copy outside the server checkout and set WALK_PUBLIC_ENV_FILE in root .env.
# Use server-only values. Do not put this file into an app build.
DAENGS_WALK_SGIS_KEY=
DAENGS_WALK_SGIS_SECRET=
DAENGS_WALK_PUBLIC_DATA_KEY=
DAENGS_WALK_PARK_CATALOG_PATH=/data/walk-public/parks.json
DAENGS_WALK_COMMERCE_CATALOG_PATH=/data/walk-public/commerce.json
DAENGS_WALK_RIVER_CATALOG_PATH=/data/walk-public/river.json
# Prepare/Check first; then set all four to true and run Start.
DAENGS_WALK_ENTRY_CONTEXT_ENABLED=false
DAENGS_WALK_PUBLIC_CONTEXT_ENABLED=false
DAENGS_WALK_AREA_CONTEXT_ENABLED=false
DAENGS_WALK_DIARY_ENABLED=false
# Preserve existing v2/photo settings in backend/.env. Enabling them requires their SQL too.
