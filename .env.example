# docker-compose.yml 이 읽는 값입니다.
# 이 파일을 .env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# ⚠ 서버 PC 전용입니다. compose 는 서버 PC 에서만 띄웁니다 — 개발 PC 에서는
# 이 파일이 필요 없습니다. 개발 PC 접속 정보는 backend/.env.example 을 보세요.
#
# backend 설정은 여기가 아니라 backend/.env 에 있습니다.

# ── Postgres (pgvector) ───────────────────────────────────────────
# ⚠ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 는 db/init/ 과 마찬가지로
#   **볼륨이 비어 있을 때 한 번만** 반영됩니다. 이미 만들어진 볼륨에서 이 값을
#   바꾸면 DB 안의 계정은 그대로라 backend 가 인증에 실패합니다.
#   이미 돌고 있는 DB 의 계정을 바꾸려면 psql 로 직접 하세요:
#     docker compose exec -it pgvector psql -U postgres
#     \password <계정>            (비밀번호 변경. 화면·히스토리에 안 남습니다)
#
# DB 가 있는 장비의 LAN IP. compose 가 읽는 값은 아니고, '팀 DB 가 어디인지'를
# 한 곳에 적어 두는 용도입니다. 개발 PC 에서 붙을 때 이 값을 backend/.env 의
# DAENGS_DB_HOST 에 넣으세요. 서버 PC 자신은 compose 네트워크로 붙으므로 안 씁니다.
POSTGRES_IP=
POSTGRES_USER=postgres
# 5432 를 LAN 에 열어 두는 구성이라 기본값을 그대로 쓰지 마세요.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb
# 호스트에 노출할 포트. 이미 5432 를 쓰고 있으면 바꾸세요.
POSTGRES_PORT=5432

# ── Redis (실시간 산책 ②) ─────────────────────────────────────────
# 값 캐시 · 일 예산 카운터 · 활성 키 집합을 담습니다 (RT-001 ④ · D-019).
#
# ⚠ **REDIS_PASSWORD 를 반드시 채우세요.** Postgres 와 달리 Redis 는 기본이
#   무인증이고, 이 구성은 포트를 LAN 에 엽니다 (개발 PC 에서도 서버 Redis 에 붙어야
#   data.go.kr 의 일 1,000회 카운터가 하나로 모이기 때문입니다). 비워 두면 같은
#   네트워크의 누구나 붙어서 FLUSHALL 할 수 있습니다.
#
# ⚠ **영숫자로만 지으세요.** DB 접속 정보와 달리 Redis 는 URL 한 줄로 넘어가서
#   (backend/.env 의 REDIS_URL, compose 의 같은 이름) @ / # 이 들어가면 깨집니다.
#   조각으로 받는 DAENGS_DB_* 와 다른 점입니다 (D-013 이 피하려던 바로 그 함정).
#
#   uv run python -c "import secrets; print(secrets.token_hex(24))"
#
# ⚠ **비어 있으면 compose 가 아예 멈춥니다** (`${REDIS_PASSWORD:?...}`). 안 뜨는 편이
#   인증 없이 열린 채로 뜨는 것보다 낫다는 판단입니다 — DAENGS_TRAINING_RAG_BASE_URL 과
#   같은 장치입니다. 배포 전에 서버 .env 에 넣으세요.
#
# 볼륨이 빌 때만 반영되는 POSTGRES_* 와 달리 이 값은 재기동하면 바로 바뀝니다.
# 대신 바꾸면 개발 PC 들의 backend/.env 에 있는 REDIS_URL 도 같이 고쳐야 합니다.
REDIS_PASSWORD=
# 호스트에 노출할 포트. 이미 6379 를 쓰고 있으면 바꾸세요.
REDIS_PORT=6379

# ── pgAdmin (docker compose --profile tools up -d 일 때만) ────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ---- Training RAG (backend container -> host-side separate FastAPI) -------
# Training RAG의 PGVector(기본 5433/dog_rag)와 DAENGS pgvector(5432/vectordb)는 별개입니다.
# 서비스 주소는 코드에 넣지 않고 서버 .env에서만 설정합니다.
DAENGS_TRAINING_RAG_BASE_URL=http://host.docker.internal:8010

# ── 피부 병변 스크리닝 (docker compose --profile screening up -d 일 때만) ──
# 학습된 가중치가 있는 **서버 디스크의 폴더**. 저장소에는 없습니다 —
# best.pt 가 163MB / 189MB 라 GitHub 의 파일당 100MB 리밋에 걸립니다.
#
# 배포 폴더(C:\deploy\daengs\releases\<커밋해시>) **바깥**에 두세요.
# 그 안에 두면 배포할 때마다 사라집니다. .env·암호화 키와 같은 취급입니다.
#
# 안에 이렇게 들어 있어야 합니다:
#   release/stage1_threshold.json
#   release/checkpoints/stage1_.../best.pt
#   release/checkpoints/stage2_.../best.pt
#
# 비워 두면 compose 가 기본값(./_models/release)을 쓰고, 그 폴더가 비어 있으면
# 스크리닝 컨테이너만 재시작 루프에 빠집니다 (다른 서비스는 멀쩡합니다).
SCREENING_RELEASE_DIR=C:\deploy\daengs\models\release

# ── 강아지 보행 영상 분석 (D-027, docker compose --profile gait up -d 일 때만) ──
# 학습된 가중치가 있는 **서버 디스크의 폴더**. 저장소에는 없습니다 —
# 원본 실험 레포(walk_demo)에서도 gitignore 대상이라 clone 만으로는 안 따라옵니다.
#
# 배포 폴더(C:\deploy\daengs\releases\<커밋해시>) **바깥**에 두세요.
# 그 안에 두면 배포할 때마다 사라집니다. .env·암호화 키와 같은 취급입니다.
#
# 안에 이렇게 들어 있어야 합니다 (파일 이름 그대로):
#   release/best.pt      ← 반려견 전용 12kp pose 모델 (약 50.7MB)
#   release/yolov8n.pt   ← crop-assist 용 범용 검출기 (약 6.2MB, COCO 원본)
#
# ⚠ walk_demo 의 models/experimental/*.pt (6개)는 **미채택 실험 가중치**입니다.
#   production 모델과 파일 크기가 비슷해 헷갈리기 쉬우니 가져오지 마세요.
#
# 비워 두면 compose 가 기본값(./gait-analysis/_models/release)을 쓰고, 그 폴더가
# 비어 있으면 컨테이너는 뜨지만 /healthz 가 ready:false 를 냅니다
# (분석 요청만 503, 다른 서비스는 멀쩡합니다).
GAIT_RELEASE_DIR=C:\deploy\daengs\models\gait\release

# 업로드 영상 크기 상한(바이트). 비워 두면 기본 150MB(157286400) 를 씁니다.
# skin-screening 의 12MB(사진)와 다른 자리입니다 — 근거는 gait-analysis/README.md.
# nginx/default.conf 의 `location /gait/` client_max_body_size(200m) 보다 낮게
# 유지하세요. 둘 중 하나를 바꾸면 다른 쪽도 같이 확인해야 합니다.
# GAIT_MAX_UPLOAD_BYTES=157286400

# ── Place 검색 (D-026, profile "place" — 기본 실행에서는 안 뜸) ─────────────
# place-db 는 pgvector 와 별개의 PostGIS 컨테이너입니다. 스키마 원본은
# place-search/alembic 입니다 (db/init 방식의 예외 — D-026).
# ⚠ 5433 을 LAN 에 엽니다(pgvector 와 같은 의도). 켜기 전에 비밀번호를 꼭 바꾸세요.
PLACE_POSTGRES_USER=place
PLACE_POSTGRES_PASSWORD=
PLACE_POSTGRES_DB=place
PLACE_POSTGRES_PORT=5433
# 공공데이터 키 — 장소 적재 배치 전용. 서버 기동에는 필요 없습니다.
# (data.go.kr 일반(Decoding) 인증키 / KorPetTourService2 인증키)
PLACE_DATA_GO_KR_SERVICE_KEY=
PLACE_KTO_SERVICE_KEY=
