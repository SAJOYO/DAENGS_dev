# docker-compose.yml 이 읽는 값입니다.
# 이 파일을 .env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# ⚠ 서버 PC 전용입니다. compose 는 서버 PC 에서만 띄웁니다 — 개발 PC 에서는
# 이 파일이 필요 없습니다. 개발 PC 접속 정보는 backend/.env.example 을 보세요.
#
# backend 설정은 여기가 아니라 backend/.env 에 있습니다.

# ── Postgres (pgvector) ───────────────────────────────────────────
# ⚠ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 는 db/init/ 과 마찬가지로
#   **볼륨이 비어 있을 때 한 번만** 반영됩니다. 이미 만들어진 볼륨에서 이 값을
#   바꾸면 DB 안의 계정은 그대로라 backend 가 인증에 실패합니다.
#   이미 돌고 있는 DB 의 계정을 바꾸려면 psql 로 직접 하세요:
#     docker compose exec -it pgvector psql -U postgres
#     \password <계정>            (비밀번호 변경. 화면·히스토리에 안 남습니다)
#
# DB 가 있는 장비의 LAN IP. compose 가 읽는 값은 아니고, '팀 DB 가 어디인지'를
# 한 곳에 적어 두는 용도입니다. 개발 PC 에서 붙을 때 이 값을 backend/.env 의
# DAENGS_DB_HOST 에 넣으세요. 서버 PC 자신은 compose 네트워크로 붙으므로 안 씁니다.
POSTGRES_IP=
POSTGRES_USER=postgres
# 5432 를 LAN 에 열어 두는 구성이라 기본값을 그대로 쓰지 마세요.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb
# 호스트에 노출할 포트. 이미 5432 를 쓰고 있으면 바꾸세요.
POSTGRES_PORT=5432

# ── Redis (실시간 산책 ②) ─────────────────────────────────────────
# 값 캐시 · 일 예산 카운터 · 활성 키 집합을 담습니다 (RT-001 ④ · D-019).
#
# ⚠ **REDIS_PASSWORD 를 반드시 채우세요.** Postgres 와 달리 Redis 는 기본이
#   무인증이고, 이 구성은 포트를 LAN 에 엽니다 (개발 PC 에서도 서버 Redis 에 붙어야
#   data.go.kr 의 일 1,000회 카운터가 하나로 모이기 때문입니다). 비워 두면 같은
#   네트워크의 누구나 붙어서 FLUSHALL 할 수 있습니다.
#
# ⚠ **영숫자로만 지으세요.** DB 접속 정보와 달리 Redis 는 URL 한 줄로 넘어가서
#   (backend/.env 의 REDIS_URL, compose 의 같은 이름) @ / # 이 들어가면 깨집니다.
#   조각으로 받는 DAENGS_DB_* 와 다른 점입니다 (D-013 이 피하려던 바로 그 함정).
#
#   uv run python -c "import secrets; print(secrets.token_hex(24))"
#
# ⚠ **비어 있으면 compose 가 아예 멈춥니다** (`${REDIS_PASSWORD:?...}`). 안 뜨는 편이
#   인증 없이 열린 채로 뜨는 것보다 낫다는 판단입니다. 배포 전에 서버 .env 에 넣으세요.
#
# 볼륨이 빌 때만 반영되는 POSTGRES_* 와 달리 이 값은 재기동하면 바로 바뀝니다.
# 대신 바꾸면 개발 PC 들의 backend/.env 에 있는 REDIS_URL 도 같이 고쳐야 합니다.
REDIS_PASSWORD=
# 호스트에 노출할 포트. 이미 6379 를 쓰고 있으면 바꾸세요.
REDIS_PORT=6379

# ── pgAdmin (docker compose --profile tools up -d 일 때만) ────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── Training RAG (backend 프로세스 안에서 돕니다) ──────────────────
# **전용 DB 도 전용 role 도 없습니다** (#112). Training 은 본체와 **같은 vectordb, 같은
# 접속 정보**를 쓰고 소유 테이블(`training_rag_documents` · `training_rag_chunks`)로만
# 나눕니다. compose 가 위 POSTGRES_* 로 RAG_PGVECTOR_DSN 을 조립하므로 **여기에 적을
# 값이 없습니다.**
#
# 옛 `dog_rag` 별도 DB 와 `TRAINING_RAG_DB_PASSWORD` 는 #105 의 구조이고 #112 가
# 대체했습니다. 자세한 것은 `docs/orchestration/architecture.md` "DB 토폴로지 (#112)".
#
# ⚠ **이미 떠 있는 서버 DB 에는 자동으로 반영되지 않습니다** — `db/init/` 은 볼륨이 빌 때만
#   돕니다. `db/migrations/2026-09-01_training_rag_into_vectordb.sql` 을 배포 후 손으로
#   적용해야 실제로 옮겨집니다.

# ── Gemini (backend 컨테이너에 직접 주입 — 별도 서비스 주소는 없습니다) ──
# Training RAG 만 쓰는 것이 아닙니다 — 대화 요약(`GeminiChatSummarizer`)도 같은 키를 씁니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000

# ── 크롤러 코퍼스 (RAG-050 — 기본 compose 실행에 포함) ─────────────────────
# 크롤 원본(`raw/`)과 크롤 로그(`manifests/crawl_log.jsonl`)가 있는 **서버 디스크의 폴더**.
# 워커·Beat 가 `/data` 로 마운트합니다. 저장소에는 없습니다 — `data/` 는 git 미추적입니다 (RAG-017).
#
# 배포 폴더(C:\deploy\daengs\releases\<커밋해시>) 와 러너 체크아웃 **바깥**에 두세요.
# 체크아웃 밑에 두면 `git clean` 한 번에 코퍼스가 통째로 사라집니다.
#
# 안에 이렇게 들어 있어야 합니다 (개발 PC 에서 `tools/corpus_pack.py` 로 만든 zip 을 그대로 푼 모양):
#   raw/<domain>/<slug>__<YYYYMMDD>.<ext>  +  같은 이름의 .meta.json
#   manifests/crawl_log.jsonl
#
# ⚠ **비어 있으면 compose 가 아예 멈춥니다** (`${DAENGS_CORPUS_DIR:?...}`). 기본값을 두면
#   체크아웃 밑 ./data 로 조용히 떨어지기 때문입니다 — REDIS_PASSWORD 와 같은 장치입니다.
# ⚠ **폴더는 있는데 crawl_log.jsonl 이 없으면 워커만 재시작 루프에 빠집니다** (다른 서비스는
#   멀쩡합니다). 로그 없이 뜨면 전 소스가 due 로 잡혀 개발 PC 와 다른 코퍼스를 만들기 때문에
#   일부러 막아 둔 것입니다. 옮기는 절차는 루트 README.md "코퍼스" 절.
DAENGS_CORPUS_DIR=C:\deploy\daengs\corpus

# ── 피부 스크리닝 가중치 ───────────────────────────────
# 허깅페이스에서 받습니다. 설정은 **`backend/.env`** 에 있습니다
# (SCREENING_RELEASE_REPO · SCREENING_RELEASE_REVISION · HF_TOKEN).
# 여기(최상단 .env)에는 스크리닝 가중치 관련 변수가 **없습니다** —
# 서버 디스크의 폴더를 물리던 방식은 없앴습니다.

# ── 강아지 보행 영상 분석 (D-029, docker compose --profile gait up -d 일 때만) ──
# 학습된 가중치가 있는 **서버 디스크의 폴더**. 저장소에는 없습니다 —
# 원본 실험 레포(walk_demo)에서도 gitignore 대상이라 clone 만으로는 안 따라옵니다.
#
# 배포 폴더(C:\deploy\daengs\releases\<커밋해시>) **바깥**에 두세요.
# 그 안에 두면 배포할 때마다 사라집니다. .env·암호화 키와 같은 취급입니다.
#
# 안에 이렇게 들어 있어야 합니다 (파일 이름 그대로):
#   release/best.pt      ← 반려견 전용 12kp pose 모델 (약 50.7MB)
#   release/yolov8n.pt   ← crop-assist 용 범용 검출기 (약 6.2MB, COCO 원본)
#
# ⚠ walk_demo 의 models/experimental/*.pt (6개)는 **미채택 실험 가중치**입니다.
#   production 모델과 파일 크기가 비슷해 헷갈리기 쉬우니 가져오지 마세요.
#
# 비워 두면 compose 가 기본값(./backend/_models/release)을 쓰고, 그 폴더가
# 비어 있으면 gait-worker 는 뜨지만 분석 job 이 FAILED 로 끝납니다
# (다른 서비스는 멀쩡합니다).
GAIT_RELEASE_DIR=C:\deploy\daengs\models\gait\release

# 업로드 영상 크기 상한(바이트). 비워 두면 기본 150MB(157286400) 를 씁니다.
# skin-screening 의 12MB(사진)와 다른 자리입니다 — 근거는 backend/src/daengs_gait/README.md.
#
# ⚠️ **아래 공용 저장소의 bridge 업로드도 같은 값을 씁니다.** D-052 로 영상 전량이
#    backend 를 지나게 됐으니, 이 값이 컨테이너 **메모리 방어선**입니다.
#
# nginx 의 `location /app/gait/` client_max_body_size(200m)
# 보다 낮게 유지하세요 — 높으면 nginx 가 먼저 끊어서 앱이 우리 413 대신 nginx 의
# HTML 을 받습니다. 둘 중 하나를 바꾸면 다른 쪽도 같이 확인해야 합니다.
# GAIT_MAX_UPLOAD_BYTES=157286400

# ── 공용 파일 저장소 — `/app/gait/*` · `/app/territory/*` (D-043, D-052) ────
# backend 가 소유하는 orchestration 계약(인증·소유권·record/job)이 쓰는 저장소 설정입니다.
# (옛 직접 HTTP `/gait/*` 의 `gait-data` 볼륨과는 다른 자리 — 그 서비스는 D-063 4단계에서 제거.)
#
# 보행 전용이 아니라 **공용**입니다: 점령지 사진이 이미 같은 변수를 읽고, 프로필 사진·
# 피부 사진·도감 카드가 같은 볼륨에 접두사로 들어옵니다. 변수 이름이 GAIT_ 인 것은
# 보행에서 시작한 역사적 이름입니다.
#
# **저장 위치는 서버의 도커 볼륨입니다** (D-052, 2026-09-04). GCS 버킷은 파지 않습니다.
# 기본값이 none 인 것은 개발 PC 가 아무 설정 없이도 뜨게 하려는 것뿐이고,
# **운영 서버는 아래 세 줄을 반드시 채웁니다.**
#
#   none | local | gcs
GAIT_STORAGE=local

# 보행 분석 엔진 (#304). legacy = daengs_gait(best.pt) · v4 = backend/gait_v4(walk_demo).
# v4 가중치(ssdlite.pt · rtmpose-m_ap10k/end2end.onnx)는 위 GAIT_RELEASE_DIR 폴더에 둡니다.
# 기본 legacy — ssdlite.pt 라이선스 결정 전 운영에서 바꾸지 마세요. 바꾸면 backend·gait-worker 재생성.
# GAIT_ENGINE=legacy
# 파일을 두는 **컨테이너 안 경로**입니다 (윈도우 경로가 아닙니다).
# compose 의 gait-bridge 볼륨이 여기에 물립니다 — backend · gait-worker ·
# territory-vision-worker 셋이 같은 곳을 봐야 분석이 됩니다.
# 값을 바꾸면 compose 의 마운트 **세 곳**도 같이 고치세요.
GAIT_LOCAL_STORAGE_DIR=/data/gait-bridge
# 앱이 파일을 올릴 주소의 앞부분 = 공개 API 오리진. 티켓의 upload_url 이 여기서 만들어집니다.
#
# ⚠️ **서버마다 다른 유일한 값입니다.** 집 서버 PC 는 아래 평문 http 이고,
#    GCP VM 은 https://daengapi.weareithero.cloud 입니다.
#    **릴리즈 앱이 보는 곳은 반드시 https 쪽**이어야 합니다 — 공개한 처리방침 6항이
#    "서버와의 통신은 HTTPS로 암호화합니다" 입니다. daengback 은 개발용입니다.
GAIT_BRIDGE_BASE_URL=http://daengback.weareithero.cloud
#
# ⚠️ 바꾼 뒤 **컨테이너 셋을 모두 재생성**해야 합니다. 환경 변수는 프로세스가 뜰 때
#    한 번만 읽고, celery 워커는 리로드가 없습니다 (2026-09-02 실측):
#      docker compose up -d backend
#      docker compose --profile gait up -d --force-recreate gait-worker
#      docker compose up -d --force-recreate territory-vision-worker
#    (gait-worker 는 --profile gait 없이는 안 뜹니다. 빠뜨리면 업로드는 되는데
#     분석만 FAILED 로 떨어져서 원인을 찾기 어렵습니다.)
#
# ⚠️ **`docker compose down -v` 를 쓰지 마세요.** -v 가 gait-bridge 볼륨을 지웁니다 —
#    영상·사진 원본이 전부 사라지고, 백업은 없습니다(D-052 가 테스트 단계라 감수).
#    그냥 `docker compose down` 은 안전합니다.
#
# 업로드 한 건의 크기 상한은 **위 GAIT_MAX_UPLOAD_BYTES 를 같이 씁니다** (그 줄 참고).
#
# ── GCS 로 되돌아갈 때 (지금은 안 씁니다) ───────────────────────────────────
# 서버가 부하를 못 받으면 아래 네 줄로 되돌아갑니다. **코드는 안 고칩니다** —
# backend 도 워커도 StoragePort 로만 저장소를 만지고, GCS 구현(Signed URL 발급·
# 다운로드·overlay 업로드·삭제)이 `core/storage.py` 의 GcsStorage 에 그대로 있습니다.
# 그 길을 고르면 위 local 두 줄과 gait-bridge 볼륨이 필요 없어집니다.
#
# GAIT_STORAGE=gcs
# GAIT_GCS_BUCKET=
# GAIT_GCS_LOCATION=asia-northeast3
#
# ⚠️ **키 파일 없이 ADC 로 가면 서명 권한을 따로 줘야 합니다.** VM 에 붙은 서비스
#    계정에는 개인키가 없어서 Signed URL 을 IAM signBlob 으로 만듭니다. 그 권한이
#    없으면 버킷도 IAM 도 다 맞는데 **첫 발급만 500** 으로 죽어 원인이 안 보입니다.
#    그 서비스 계정에 **자기 자신에 대해** roles/iam.serviceAccountTokenCreator 를
#    주세요 (버킷 권한 roles/storage.objectAdmin 은 **버킷 단위로**, 프로젝트 전체 아님).
#    이 함정이 자체 호스팅을 고른 이유 중 하나입니다.
#
# 자격증명은 GCP 표준(ADC)입니다. 서비스 계정 키 파일을 쓰면 아래 둘을 같이 켜고,
# docker-compose.yml 의 주석 처리된 마운트(세 서비스 모두)도 엽니다.
# 키 파일은 **배포 폴더 바깥**에 두세요 — 재배포에 지워지면 안 됩니다.
# GAIT_GCP_CREDENTIALS_FILE=C:\deploy\daengs\secrets\gcp-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# ── Place 검색 (D-026, D-027 — 기본 compose 실행에 포함) ────────────────────
# place-db 는 pgvector 와 별개의 PostGIS 컨테이너입니다. 스키마 원본은
# backend/infra/place/alembic 입니다 (db/init 방식의 예외 — D-026, D-039).
# DB 포트는 호스트에 열지 않으며 place-search 만 compose 네트워크에서 접근합니다.
PLACE_POSTGRES_USER=place
# 조각으로 전달하므로 @ / # 등 URL 예약 문자를 써도 됩니다 (D-028).
PLACE_POSTGRES_PASSWORD=
PLACE_POSTGRES_DB=place
# 공공데이터 키 — 장소 적재 배치 전용. 서버 기동에는 필요 없습니다.
# (data.go.kr 일반(Decoding) 인증키 / KorPetTourService2 인증키)
PLACE_DATA_GO_KR_SERVICE_KEY=
PLACE_KTO_SERVICE_KEY=

# ── Journey (DAENGS_geo main@c5f0d5f의 APP 경로 이주) ─────────────────────
# Place 카드를 선택한 뒤 `POST /journey`가 쓰는 경로 제공사만 설정합니다.
# fake = 키 없이 추정값(status=estimate), none = 해당 수단을 unavailable로 표시합니다.
# 원본에서 실제 경로 호출이 구현된 외부 provider는 TMAP 보행 경로뿐입니다.
JOURNEY_WALK_ROUTE_PROVIDER=fake
JOURNEY_CAR_ROUTE_PROVIDER=fake
JOURNEY_TRANSIT_ROUTE_PROVIDER=fake
# 실제 TMAP 호출은 dev 정책에서만 요청당 4회·프로세스 시간당 60회로 제한됩니다.
JOURNEY_USAGE_POLICY=deny-all
JOURNEY_TMAP_APP_KEY=

# ── 트레이싱 (기본 꺼짐) ──────────────────────────────────────────────────
# `/assistant/query` 한 요청의 라우팅 결정·검색 청크·프롬프트·Gemini 답변을 한
# 트레이스로 봅니다. 실사용 민원이 실사용 질문에서 나와 동결 골드셋으로는 못
# 좁히는 문제를 위한 것입니다 (D-054).
#
# **트레이스는 우리 GCP 프로젝트의 Cloud Trace 로 갑니다.** langsmith 는 계측
# SDK 로만 쓰고, LangSmith 라는 회사에는 아무것도 안 갑니다 — 새 벤더도, 새 계정도,
# API 키도 없습니다. 이미 쓰는 GCP 라 처리방침의 제3자 목록도 그대로입니다.
#
#     backend ──OTLP──▶ otel-collector ──▶ Cloud Trace
#
# 켜는 순서:
#   1) GOOGLE_CLOUD_PROJECT 를 채웁니다 (아래). 비워 두면 exporter 가 자격증명에서
#      프로젝트를 유추하고, 그것도 없으면 collector 가 기동에 실패합니다
#      (`docker compose logs otel-collector` 에 보입니다).
#   2) LANGSMITH_TRACING=true
#   3) docker compose --profile tracing up -d
#
# ⚠ **backend/.env 가 아니라 이 파일입니다.** compose 의 environment 로 들어가야
#    프로세스 환경 변수가 됩니다 — langsmith SDK 는 os.environ 만 봅니다.
LANGSMITH_TRACING=false
# otel = 우리 GCP. langsmith = 제3자(LangSmith 클라우드, API 키 필요 + 처리방침 개정).
LANGSMITH_TRACING_MODE=otel
LANGSMITH_PROJECT=daengs
# Cloud Trace 를 받을 GCP 프로젝트. gait 가 쓰는 것과 같은 프로젝트·같은 키 파일이면 됩니다.
# 권한은 roles/cloudtrace.agent 하나입니다.
GOOGLE_CLOUD_PROJECT=
# 비용: 월 2.5M 스팬 무료, 초과 $0.20/M. 요청당 6~10 스팬이라 월 25만 요청까지 무료입니다.

# ── LangSmith 클라우드로 되돌릴 때만 (제3자 제공) ─────────────────────────
# MODE=langsmith 로 바꿀 때만 씁니다. 그때는 대화 내용이 국외 사업자에게 나가므로
# **개인정보처리방침의 제3자 제공 목록을 먼저 채워야 합니다.**
#
# 예외는 **개발 PC** 입니다 — 개발자가 직접 치는 질문을 본인 계정으로 보내는 것은
# 이 결정의 범위 밖이라, 거기서는 MODE=langsmith 를 셸 환경 변수로 줍니다. 절차와
# 함정은 루트 README.md "트레이스를 LangSmith 로 보기". 이 파일(compose)과는 무관합니다.
#LANGSMITH_API_KEY=
#   APAC : https://apac.api.smith.langchain.com
#   EU   : https://eu.api.smith.langchain.com
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Walk public sources: keep the real file outside the server checkout.
# Copy backend/.env.walk-public.example, fill secrets, then follow docs/walk/runtime.md.
# WALK_PUBLIC_ENV_FILE=C:/deploy/daengs/walk-public.env
