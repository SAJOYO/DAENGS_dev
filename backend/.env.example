# backend 가 읽는 값입니다.
# 이 파일을 backend/.env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# 접두사 DAENGS_ 는 src/daengs_backend/config.py 의 Settings 와 맞춘 것입니다.

# 값은 JSON 배열로 씁니다.
# 서버에 올릴 때는 프론트 도메인을 추가하세요. 예) "http://daengs.example"
# 등록하는 것은 '부르는 쪽'(프론트)이지 API 도메인이 아닙니다.
DAENGS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 개발 서버 바인딩. 컨테이너에서는 compose 가 0.0.0.0 으로 덮어씁니다.
#DAENGS_HOST=127.0.0.1
#DAENGS_PORT=8000

# ── DB ────────────────────────────────────────────────────────────
# 개발 PC 에서 uv run dev 로 띄울 때 쓰는 접속 정보입니다.
# URL 한 줄이 아니라 조각으로 받습니다 (D-013).
#
# DB 는 각자 PC 가 아니라 서버 PC 에 하나만 떠 있습니다.
# 값은 최상단 .env 의 POSTGRES_IP / POSTGRES_USER / POSTGRES_PASSWORD 와 맞추세요.
# localhost 가 아닙니다 — 로컬에 Postgres 를 따로 띄운 게 아니라면 안 붙습니다.
#
# 서버 PC 의 컨테이너에서는 이 값을 쓰지 않습니다.
# compose 가 같은 이름의 환경 변수로 덮어써서 (DAENGS_DB_HOST=pgvector)
# 같은 compose 네트워크의 pgvector 서비스로 바로 붙습니다.
#
# db_host 와 db_password 는 기본값이 없습니다. 없으면 backend 가 뜨지 않습니다.
#
# ⚠ PC 마다 다른 값 — 은 사실 여기 없습니다. 서버 DB 가 팀에 하나뿐이라
# DAENGS_DB_HOST 도 모든 개발 PC 에서 서버 IP 로 동일합니다. (컨테이너 안에서만
# compose 가 DAENGS_DB_HOST=pgvector 로 덮어써서 예외가 됩니다.)
DAENGS_DB_HOST=192.168.0.22
# ⚠ 서버가 실제로 쓰는 계정과 같은 값이어야 합니다 — 최상단 .env.example 의
# 기본값(POSTGRES_USER=postgres)을 그대로 믿지 마세요. 그건 볼륨을 처음 만들 때의
# 소유자 계정이고, 앱이 실제로 쓰는 계정은 psql 로 따로 만든 daengs 입니다
# (CLAUDE.md 의 "POSTGRES_USER · ... 도 볼륨이 빌 때만 반영됩니다" 항목 참고).
# 값이 바뀌었을 수 있으니 정확한 비밀번호는 팀 채널로 확인하세요.
DAENGS_DB_USER=daengs
DAENGS_DB_PASSWORD=
#DAENGS_DB_PORT=5432
#DAENGS_DB_NAME=vectordb
#
# 옛 이름입니다. 이 줄이 .env 에 남아 있으면 backend 가 뜨지 않고 알려 줍니다.
#DAENGS_DATABASE_URL=...

# 실행되는 SQL 을 로그로 찍습니다. 쿼리를 들여다볼 때만.
#DAENGS_DB_ECHO=false

# ── 암호화 키 ─────────────────────────────────────────────────────
# 셋 다 필수입니다. 없으면 backend 가 뜨지 않습니다 (기본값을 두지 않았습니다).
#
# ⚠ 셋 다 모든 PC(개발 PC 전부 + 서버)가 같은 값을 써야 합니다. DB 가 팀에 하나뿐이라
# (서버 DB 를 개발 PC 에서도 그대로 씁니다), 키가 다르면 한쪽에서 암호화·조회한
# 데이터를 다른 쪽이 못 읽습니다. **팀 채널로 값을 공유받아 그대로 채우세요.**
# 아래 명령은 그 값이 아직 없을 때(처음 만드는 사람) 한 번만 쓰는 것이지, 각자
# 새로 돌리는 게 아닙니다 — 새로 돌리면 이미 저장된 데이터가 안 열립니다.
#
#   uv run python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# (세 키는 서로 다른 값이어야 합니다 — 위 명령을 세 번 돌려 JWE / AES / blind index 에
# 하나씩 넣으세요. 이후로는 팀 전체가 그 세 값을 그대로 공유해 씁니다.)
#
# 잃었을 때 벌어지는 일이 서로 달라서 셋으로 나눠 뒀습니다 (D-012).
#   JWE         : 전원 로그아웃. 새로 만들면 끝
#   blind index : 해시 조회 불가. AES 키가 살아 있으면 전부 재계산
#   AES         : 암호문이 영구히 안 열림  ← 이것만 진짜 조심하면 됩니다
#
# 키는 반드시 어딘가에 백업하세요 — 팀 채널 하나에만 있으면 그게 사라지는 순간
# 아무도 못 엽니다. 단, DB 백업과 **같은 곳에 두지 마세요.** 같이 새면 암호화한
# 의미가 없습니다.
DAENGS_JWE_KEY=
DAENGS_AES_KEY=
DAENGS_BLIND_INDEX_KEY=
