# backend 가 읽는 값입니다.
# 이 파일을 backend/.env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# 접두사 DAENGS_ 는 src/daengs_backend/config.py 의 Settings 와 맞춘 것입니다.

# 값은 JSON 배열로 씁니다.
# 서버에 올릴 때는 프론트 도메인을 추가하세요. 예) "http://daengs.example"
# 등록하는 것은 '부르는 쪽'(프론트)이지 API 도메인이 아닙니다.
DAENGS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 개발 서버 바인딩. 컨테이너에서는 compose 가 0.0.0.0 으로 덮어씁니다.
#DAENGS_HOST=127.0.0.1
#DAENGS_PORT=8000
