# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 커밋되지 않습니다)
#   Copy-Item .env.example .env
#
# docker-compose.yml 과 backend 가 함께 읽습니다.

# ── Postgres (pgvector) ───────────────────────────────────────────
# 운영 서버에서는 반드시 바꾸세요. 비워 두면 compose 기본값 postgres 가 쓰입니다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb
# 호스트에 노출할 포트. 5432 가 이미 쓰이고 있으면 바꾸세요.
POSTGRES_PORT=5432

# ── pgAdmin (docker compose --profile tools up -d 일 때만) ────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── backend ───────────────────────────────────────────────────────
# 접두사 DAENGS_ 는 src/daengs_backend/config.py 의 Settings 와 맞춘 것입니다.
# 값은 JSON 배열로 씁니다.
DAENGS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 호스트에서 uv 로 띄울 때 기준. backend 를 컨테이너로 옮기면
# localhost 대신 compose 서비스 이름(pgvector)을 쓰세요.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vectordb
