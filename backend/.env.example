# backend 가 읽는 값입니다.
# 이 파일을 backend/.env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# 접두사 DAENGS_ 는 src/daengs_backend/config.py 의 Settings 와 맞춘 것입니다.

# 값은 JSON 배열로 씁니다.
# 서버에 올릴 때는 프론트 도메인을 추가하세요. 예) "http://daengs.example"
# 등록하는 것은 '부르는 쪽'(프론트)이지 API 도메인이 아닙니다.
DAENGS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 개발 서버 바인딩. 컨테이너에서는 compose 가 0.0.0.0 으로 덮어씁니다.
#DAENGS_HOST=127.0.0.1
#DAENGS_PORT=8000

# ── DB ────────────────────────────────────────────────────────────
# 개발 PC 에서 uv run dev 로 띄울 때 쓰는 접속 정보입니다.
# URL 한 줄이 아니라 조각으로 받습니다 (D-013).
#
# DB 는 각자 PC 가 아니라 서버 PC 에 하나만 떠 있습니다.
# 값은 최상단 .env 의 POSTGRES_IP / POSTGRES_USER / POSTGRES_PASSWORD 와 맞추세요.
# localhost 가 아닙니다 — 로컬에 Postgres 를 따로 띄운 게 아니라면 안 붙습니다.
#
# 서버 PC 의 컨테이너에서는 이 값을 쓰지 않습니다.
# compose 가 같은 이름의 환경 변수로 덮어써서 (DAENGS_DB_HOST=pgvector)
# 같은 compose 네트워크의 pgvector 서비스로 바로 붙습니다.
#
# db_host 와 db_password 는 기본값이 없습니다. 없으면 backend 가 뜨지 않습니다.
#
# ⚠ PC 마다 다른 값 — 은 사실 여기 없습니다. 서버 DB 가 팀에 하나뿐이라
# DAENGS_DB_HOST 도 모든 개발 PC 에서 서버 IP 로 동일합니다. (컨테이너 안에서만
# compose 가 DAENGS_DB_HOST=pgvector 로 덮어써서 예외가 됩니다.)
DAENGS_DB_HOST=192.168.0.22
# ⚠ 서버가 실제로 쓰는 계정과 같은 값이어야 합니다 — 최상단 .env.example 의
# 기본값(POSTGRES_USER=postgres)을 그대로 믿지 마세요. 그건 볼륨을 처음 만들 때의
# 소유자 계정이고, 앱이 실제로 쓰는 계정은 psql 로 따로 만든 daengs 입니다
# (CLAUDE.md 의 "POSTGRES_USER · ... 도 볼륨이 빌 때만 반영됩니다" 항목 참고).
# 값이 바뀌었을 수 있으니 정확한 비밀번호는 팀 채널로 확인하세요.
DAENGS_DB_USER=daengs
DAENGS_DB_PASSWORD=
#DAENGS_DB_PORT=5432
#DAENGS_DB_NAME=vectordb

# ---- Training RAG gateway --------------------------------------------------
# 로컬에서는 별도 RAG FastAPI를 8010 포트로 실행합니다. backend 컨테이너에서는
# compose 최상위 .env의 DAENGS_TRAINING_RAG_BASE_URL을 host.docker.internal 주소로 둡니다.
DAENGS_TRAINING_RAG_BASE_URL=http://127.0.0.1:8010
DAENGS_TRAINING_RAG_CONNECT_TIMEOUT_SECONDS=3
DAENGS_TRAINING_RAG_READ_TIMEOUT_SECONDS=45
# 로그인 UI가 연결되기 전 로컬 데모에서만 true. 배포에서는 false를 유지합니다.
DAENGS_TRAINING_RAG_ALLOW_ANONYMOUS_DEMO=false
#
# 옛 이름입니다. 이 줄이 .env 에 남아 있으면 backend 가 뜨지 않고 알려 줍니다.
#DAENGS_DATABASE_URL=...

# 실행되는 SQL 을 로그로 찍습니다. 쿼리를 들여다볼 때만.
#DAENGS_DB_ECHO=false

# ── 쿠키 ──────────────────────────────────────────────────────────
# 로그인 토큰은 httpOnly 쿠키로 나갑니다 (D-015).
#
# ⚠ HTTPS 를 붙이면 반드시 true 로 바꾸세요. 지금 배포가 http 라 기본값이 false 입니다.
# Secure 쿠키는 https 로만 전송돼서, 지금 켜면 로그인이 되고도 쿠키가 안 실려
# 곧바로 로그아웃됩니다. 반대로 https 로 옮긴 뒤에도 false 로 두면 토큰이
# 평문으로 오갑니다.
#DAENGS_COOKIE_SECURE=false

# ── 암호화 키 ─────────────────────────────────────────────────────
# 셋 다 필수입니다. 없으면 backend 가 뜨지 않습니다 (기본값을 두지 않았습니다).
#
# ⚠ 셋 다 모든 PC(개발 PC 전부 + 서버)가 같은 값을 써야 합니다. DB 가 팀에 하나뿐이라
# (서버 DB 를 개발 PC 에서도 그대로 씁니다), 키가 다르면 한쪽에서 암호화·조회한
# 데이터를 다른 쪽이 못 읽습니다. **팀 채널로 값을 공유받아 그대로 채우세요.**
# 아래 명령은 그 값이 아직 없을 때(처음 만드는 사람) 한 번만 쓰는 것이지, 각자
# 새로 돌리는 게 아닙니다 — 새로 돌리면 이미 저장된 데이터가 안 열립니다.
#
#   uv run python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# (세 키는 서로 다른 값이어야 합니다 — 위 명령을 세 번 돌려 JWE / AES / blind index 에
# 하나씩 넣으세요. 이후로는 팀 전체가 그 세 값을 그대로 공유해 씁니다.)
#
# 잃었을 때 벌어지는 일이 서로 달라서 셋으로 나눠 뒀습니다 (D-012).
#   JWE         : 전원 로그아웃. 새로 만들면 끝
#   blind index : 해시 조회 불가. AES 키가 살아 있으면 전부 재계산
#   AES         : 암호문이 영구히 안 열림  ← 이것만 진짜 조심하면 됩니다
#
# 키는 반드시 어딘가에 백업하세요 — 팀 채널 하나에만 있으면 그게 사라지는 순간
# 아무도 못 엽니다. 단, DB 백업과 **같은 곳에 두지 마세요.** 같이 새면 암호화한
# 의미가 없습니다.
DAENGS_JWE_KEY=
DAENGS_AES_KEY=
DAENGS_BLIND_INDEX_KEY=


# ── 카카오 소셜 로그인 ────────────────────────────────────────────────
# 앱이 보낸 id_token 의 `aud` 와 대조할 **앱 키 목록**입니다 —
# **"이 토큰이 우리 앱에게 발급된 것인가"**. 이 검사가 없으면 다른 카카오 앱에서
# 받은 토큰으로도 우리 서비스에 계정이 생깁니다 (D-017).
#
# **왜 하나가 아니라 목록인가.** 카카오는 인가 요청에 쓴 앱 키를 그대로 `aud` 에
# 넣습니다. 그래서 같은 애플리케이션이라도 들어온 경로마다 값이 다릅니다:
#
#     Android / iOS SDK   네이티브 앱 키     ← 앱 로그인
#     JavaScript SDK      JavaScript 키      ← 웹 로그인 (아직 없음)
#     REST API            REST API 키        ← uv run kakao-token
#
# 하나만 넣어 두면 나머지 경로가 통째로 401 이 됩니다. 콘솔의
# [내 애플리케이션 → 앱 설정 → 앱 키] 에 네 개가 함께 있습니다.
#
# ⚠ **한 애플리케이션의 키만 넣으세요.** 카카오 회원번호(sub)는 앱 단위라, 다른
#   애플리케이션의 키를 섞으면 같은 사람이 서로 다른 회원으로 갈라집니다.
# ⚠ **어드민 키는 넣지 마세요.** aud 로 오지 않고, 그 키 하나로 전 회원을 조작합니다.
#
# 비밀이 아닙니다 (앱에도 들어가 있습니다). 그래도 기본값을 두지 않습니다 —
# **비워 두면 aud 검증이 통째로 건너뛰어집니다** (joserfc 가 빈 목록이면 검사를
# 하지 않습니다). 그래서 비어 있으면 backend 가 뜨지 않습니다. 값은 JSON 배열입니다.
DAENGS_KAKAO_APP_KEYS=["<네이티브 앱 키>","<REST API 키>"]

# `uv run kakao-token` **전용**입니다. 로그인 검증에는 쓰이지 않습니다.
# 그 CLI 는 REST 흐름이라 client_id 자리에 REST API 키가 필요한데, 위 목록에서는
# 어느 것이 REST 키인지 알 수 없어서 한 줄 더 둡니다. `--client-id` 로 넘겨도 됩니다.
# 비워 두어도 backend 는 정상입니다.
#DAENGS_KAKAO_REST_API_KEY=


# ── 생활비서 RAG(①) · 실시간 산책(②) ─────────────────────────────────
# `daengs_life` 패키지가 읽는 값입니다 (D-018 로 이관). 발급처와 용도는
# docs/data-sources.md §9 · docs/realtime-apis.md.
#
# ⚠ **여기만 접두사가 없습니다.** 위 DAENGS_* 와 달리 이 이름들은 바꾸지 않았습니다:
#   · POSTGRES_* 는 최상단 .env 의 **compose 값을 그대로 읽습니다.** pgvector 컨테이너와
#     공유하는 이름이라 접두사를 붙이면 rag 가 DB 를 못 찾습니다.
#   · API 키는 발급 기관이 부르는 이름 그대로입니다 (docs/data-sources.md §9 와 1:1).
# 두 Settings 는 extra="ignore" 라 한 파일에 섞여 있어도 서로를 무시합니다.
#
# ⚠ DAENGS_KAKAO_APP_KEYS(위, 소셜 로그인 aud 검증)와 KAKAO_REST_KEY(아래, Local
#   주소 조회)는 **다른 용도**입니다. 같은 콘솔의 REST API 키를 양쪽에 넣어도 되지만
#   필드가 둘입니다. 위는 목록, 아래는 값 하나입니다.

# --- API 키 ---
# ⚠ DATA_GO_KR_KEY 는 포털이 Encoding / Decoding 두 벌로 보여줍니다. 맞는 것은 Decoding
#   쪽이고, Encoding 키를 넣으면 %2F → %252F 이중 인코딩으로 실패합니다
#   (realtime-apis.md §6.1 함정 1). 확인은 `uv run python -m daengs_life.realtime config`.
LAW_OC=
DATA_GO_KR_KEY=
KAKAO_REST_KEY=
SEOUL_OPEN_DATA_KEY=
KMA_HUB_KEY=

# --- LLM (9단계 생성) ---
# 모델명을 상수로 안 박은 이유: 세대가 바뀌면 이름이 바뀌는데, 코드를 고치는 것과
# 이 한 줄을 고치는 것은 되돌리는 비용이 다릅니다 (RAG-028).
GEMINI_API_KEY=
# 2026-08-27 부터 기본값은 gemini-3.1-flash-lite 입니다 (D-021). 9단계가 아직 관찰
# 단계라 체급보다 회전을 골랐고, 되돌리기가 이 한 줄이라 쌉니다.
# 실재하는 이름인지는 models.list() 로 확인하세요 — 세대가 바뀌면 옛 이름이 404 가 됩니다.
#GEMINI_MODEL=gemini-3.1-flash-lite
#
# Gemini 호출 타임아웃. ⚠ **밀리초입니다** (google-genai 의 HttpOptions.timeout).
# 30 을 넣으면 30밀리초가 되어 /ask 가 전부 504 가 됩니다. 이름에 _MS 가 붙은 이유입니다.
#GEMINI_TIMEOUT_MS=30000

# --- 캐시 (②) ---
# 실시간 산책의 값 캐시 · **일 예산 카운터** · 활성 키 집합이 여기 삽니다 (RT-001 ④).
#
# ⚠ DB 와 마찬가지로 **로컬이 아니라 서버 PC 의 Redis** 를 보게 하세요. 개발 PC 에
#   따로 띄우면 카운터가 갈려서, data.go.kr 의 일 1,000회 제약을 양쪽이 각자 세다가
#   실제로는 한도를 넘겨 부르게 됩니다. 주소·비밀번호는 최상단 .env 의
#   POSTGRES_IP / REDIS_PORT / REDIS_PASSWORD 와 맞추세요.
#
# ⚠ **URL 한 줄입니다.** 비밀번호에 @ / # 이 들어가면 깨집니다 — DAENGS_DB_* 를 조각으로
#   받는 이유(D-013)가 여기는 적용되지 않습니다. 최상단 .env.example 대로 영숫자로만.
#
# 서버 PC 의 컨테이너에서는 이 값을 쓰지 않습니다. compose 가 같은 이름으로
# redis://:<비번>@redis:6379/0 을 덮어씁니다 (DAENGS_DB_HOST 와 같은 방식).
#
# 비워 두거나 연결에 실패하면 프로세스 메모리로 떨어집니다 — "Redis 를 쓰되 없어도
# 돈다"(RT-001 ④-c). 앱은 그대로 뜨지만 예산 카운터가 재시작마다 리셋됩니다.
# 그 판단은 프로세스당 한 번뿐이라, 나중에 Redis 가 올라와도 저절로 붙지는 않습니다.
# ⚠ 비밀번호는 **`:` 뒤**입니다. 사용자 이름 자리(`//` 와 `:` 사이)는 비워 두세요 —
#   거기 넣으면 redis-py 가 ACL 사용자로 보내는데, --requirepass 만 건 서버에는
#   그런 사용자가 없어 인증에 실패합니다. 그리고 그 실패는 조용히 메모리 폴백입니다.
#     맞음  redis://:mypassword@192.168.0.22:6379/0
#     틀림  redis://mypassword@192.168.0.22:6379/0
REDIS_URL=redis://:<비밀번호>@192.168.0.22:6379/0

# --- 경로 override ---
# 레포 안에서 실행하면 `<레포>/data` 를 알아서 찾습니다. 지정하는 경우는 둘입니다.
#
# ⓐ **워크트리를 쓰면 지정하세요 — 이게 기본입니다.** `data/` 는 git 미추적이라(RAG-017)
#    워크트리 안에 따로 생기고 **워크트리를 지우면 코퍼스가 같이 지워집니다.** 실제로
#    조례 208건·보조금24 37건을 포함한 parsed 250건을 그렇게 잃었습니다 — 어느 PC 에도
#    남아 있지 않아 재수집으로만 복구됩니다. 개정되는 원문은 재수집이 곧 다른 코퍼스라
#    그건 복구가 아닙니다. 메인 체크아웃의 절대 경로로 고정해서 한 곳에만 쌓으세요.
#    (같은 `data/` 를 두 워크트리가 동시에 쓰면 부딪힙니다. 코퍼스를 통째로 잃는 것보다
#     싼 값이라 그렇게 둡니다 — 재파싱 중에 다른 쪽에서 pytest 를 돌리지만 마세요.)
#
# ⓑ 컨테이너처럼 레포 밖에서 돌릴 때. 이때는 볼륨을 붙입니다 (예: /data).
#    서버의 워커·Beat 가 그 형태입니다 — compose 가 `DAENGS_DATA_DIR=/data` 를 넣고 최상단
#    `.env` 의 `DAENGS_CORPUS_DIR` 을 거기에 마운트합니다 (RAG-050). 이 파일에는 안 적습니다.
#DAENGS_DATA_DIR=C:/Users/403/Documents/workspace/DAENGS_dev/data

# --- 임베딩 ---
# 서빙과 적재가 **같은 모델이어야 합니다.** 2026-08-27 에 판정 승자로 올렸습니다 (D-021) —
# 코퍼스를 0에서 다시 만드는 김에 재적재 비용이 사라졌기 때문입니다 (RAG-024).
# 교체는 이 한 줄이거나 `--model` 한 번입니다.
#
# ⚠ **어긋나면 조용히 틀립니다.** 문서 벡터와 질의 벡터가 다른 모델이면 두 벡터가 다른
#   공간에 있어 코사인이 무의미해지는데, 차원이 셋 다 1024 라 예외가 하나도 안 납니다.
#   그럴듯한 순위가 그냥 나옵니다. 기동 로그의 "임베딩 모델 불일치" 경고를 보세요.
#EMBEDDING_MODEL_KEY=qwen3-embedding-0.6b

# --- /ask 예열 ---
# 기동할 때 임베딩 모델(약 1.2GB)을 미리 올릴지. 기본 true 이고, 서버에서는 켜 두세요.
#
# 끄면 모델이 안 뜨는 게 아니라 **첫 /ask 요청이 로드를 뭅니다** (5~7초). 개발 PC 에서
# /ask 말고 다른 걸 보는 동안, 또는 ml 그룹을 깐 PC 에서 RAM 을 아끼고 싶을 때 끕니다.
# (테스트는 conftest.py 가 알아서 끕니다 — 안 끄면 실서버 DB 에까지 붙습니다.)
#DAENGS_WARM_UP_ENCODER=true
