# backend 가 읽는 값입니다.
# 이 파일을 backend/.env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# 접두사 DAENGS_ 는 src/daengs_backend/config.py 의 Settings 와 맞춘 것입니다.

# 값은 JSON 배열로 씁니다.
# 서버에 올릴 때는 프론트 도메인을 추가하세요. 예) "http://daengs.example"
# 등록하는 것은 '부르는 쪽'(프론트)이지 API 도메인이 아닙니다.
DAENGS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 개발 서버 바인딩. 컨테이너에서는 compose 가 0.0.0.0 으로 덮어씁니다.
#DAENGS_HOST=127.0.0.1
#DAENGS_PORT=8000

# ── DB ────────────────────────────────────────────────────────────
# 개발 PC 에서 uv run dev 로 띄울 때 쓰는 접속 정보입니다.
# URL 한 줄이 아니라 조각으로 받습니다 (D-013).
#
# DB 는 각자 PC 가 아니라 서버 PC 에 하나만 떠 있습니다.
# 값은 최상단 .env 의 POSTGRES_IP / POSTGRES_USER / POSTGRES_PASSWORD 와 맞추세요.
# localhost 가 아닙니다 — 로컬에 Postgres 를 따로 띄운 게 아니라면 안 붙습니다.
#
# 서버 PC 의 컨테이너에서는 이 값을 쓰지 않습니다.
# compose 가 같은 이름의 환경 변수로 덮어써서 (DAENGS_DB_HOST=pgvector)
# 같은 compose 네트워크의 pgvector 서비스로 바로 붙습니다.
#
# db_host 와 db_password 는 기본값이 없습니다. 없으면 backend 가 뜨지 않습니다.
#
# ⚠ PC 마다 다른 값 — 은 사실 여기 없습니다. 서버 DB 가 팀에 하나뿐이라
# DAENGS_DB_HOST 도 모든 개발 PC 에서 서버 IP 로 동일합니다. (컨테이너 안에서만
# compose 가 DAENGS_DB_HOST=pgvector 로 덮어써서 예외가 됩니다.)
DAENGS_DB_HOST=192.168.0.22
# ⚠ 서버가 실제로 쓰는 계정과 같은 값이어야 합니다 — 최상단 .env.example 의
# 기본값(POSTGRES_USER=postgres)을 그대로 믿지 마세요. 그건 볼륨을 처음 만들 때의
# 소유자 계정이고, 앱이 실제로 쓰는 계정은 psql 로 따로 만든 daengs 입니다
# (CLAUDE.md 의 "POSTGRES_USER · ... 도 볼륨이 빌 때만 반영됩니다" 항목 참고).
# 값이 바뀌었을 수 있으니 정확한 비밀번호는 팀 채널로 확인하세요.
DAENGS_DB_USER=daengs
DAENGS_DB_PASSWORD=
#DAENGS_DB_PORT=5432
#DAENGS_DB_NAME=vectordb

# ---- Process-local Training RAG --------------------------------------------
# 별도 Training 서비스 URL이나 HTTP timeout 설정은 없습니다.
# 로그인 UI가 연결되기 전 로컬 데모에서만 true. 배포에서는 false를 유지합니다.
DAENGS_TRAINING_RAG_ALLOW_ANONYMOUS_DEMO=false
#
# 옛 이름입니다. 이 줄이 .env 에 남아 있으면 backend 가 뜨지 않고 알려 줍니다.
#DAENGS_DATABASE_URL=...

# 실행되는 SQL 을 로그로 찍습니다. 쿼리를 들여다볼 때만.
#DAENGS_DB_ECHO=false

# ── 오케스트레이터 구현 선택 ──────────────────────────────────────
# `/assistant/query` 를 어느 구현이 답하는가. langgraph | agent
#
# **기본값 그대로 두면 됩니다.** LangGraph 와 LangChain 에이전트 중 무엇이 나은지
# 재 보려고 두 구현을 병존시킨 것이고, 운영값은 langgraph 입니다.
# 두 구현을 나란히 재는 벤치마크는 이 값을 안 씁니다 —
# `build_orchestrator("langgraph")` / `("agent")` 로 객체를 둘 만듭니다.
#DAENGS_ORCHESTRATOR=langgraph
#
# 에이전트 한 턴의 예산. **답이 아니라 안전장치입니다** — 에이전트가 루프를 돌아
# 비싼 것 자체가 비교에서 재야 할 것이라, 깎아서 결과를 미리 만들지 않습니다.
# langgraph 로 돌 때는 안 읽습니다.
#DAENGS_AGENT_TURN_TIMEOUT_MS=60000
#DAENGS_AGENT_RECURSION_LIMIT=25

# ── 일반 답변 폴백 (#279) ─────────────────────────────────────────
# 훈련·제도·산책·장소 중 어느 것도 아닌 질문에 "답할 수 없다" 대신 Gemini 생성 답변을
# 붙입니다 (`orchestration/adapters/general.py`). 근거 없이 답하는 대신 안전 프롬프트가
# 진단·약/용량·법령/요금/수치 주장을 막고, 그런 질문은 REFUSED 로 안내만 합니다.
#
# **기본값 false 입니다 — 머지만으로는 아무것도 안 바뀝니다.** #277 의 판정 결과를 보고
# 켭니다. 켤 때는 아래 한 줄 뒤 `docker compose restart backend`. 명시 신호
# (`requested_capability`)와 골드 회귀 러너는 이 값을 읽지 않습니다.
#DAENGS_GENERAL_FALLBACK=false

# ── 쿠키 ──────────────────────────────────────────────────────────
# 로그인 토큰은 httpOnly 쿠키로 나갑니다 (D-015).
#
# ⚠ HTTPS 를 붙이면 반드시 true 로 바꾸세요. 지금 배포가 http 라 기본값이 false 입니다.
# Secure 쿠키는 https 로만 전송돼서, 지금 켜면 로그인이 되고도 쿠키가 안 실려
# 곧바로 로그아웃됩니다. 반대로 https 로 옮긴 뒤에도 false 로 두면 토큰이
# 평문으로 오갑니다.
#DAENGS_COOKIE_SECURE=false

# ── 암호화 키 ─────────────────────────────────────────────────────
# 셋 다 필수입니다. 없으면 backend 가 뜨지 않습니다 (기본값을 두지 않았습니다).
#
# ⚠ 셋 다 모든 PC(개발 PC 전부 + 서버)가 같은 값을 써야 합니다. DB 가 팀에 하나뿐이라
# (서버 DB 를 개발 PC 에서도 그대로 씁니다), 키가 다르면 한쪽에서 암호화·조회한
# 데이터를 다른 쪽이 못 읽습니다. **팀 채널로 값을 공유받아 그대로 채우세요.**
# 아래 명령은 그 값이 아직 없을 때(처음 만드는 사람) 한 번만 쓰는 것이지, 각자
# 새로 돌리는 게 아닙니다 — 새로 돌리면 이미 저장된 데이터가 안 열립니다.
#
#   uv run python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# (세 키는 서로 다른 값이어야 합니다 — 위 명령을 세 번 돌려 JWE / AES / blind index 에
# 하나씩 넣으세요. 이후로는 팀 전체가 그 세 값을 그대로 공유해 씁니다.)
#
# 잃었을 때 벌어지는 일이 서로 달라서 셋으로 나눠 뒀습니다 (D-012).
#   JWE         : 전원 로그아웃. 새로 만들면 끝
#   blind index : 해시 조회 불가. AES 키가 살아 있으면 전부 재계산
#   AES         : 암호문이 영구히 안 열림  ← 이것만 진짜 조심하면 됩니다
#
# 키는 반드시 어딘가에 백업하세요 — 팀 채널 하나에만 있으면 그게 사라지는 순간
# 아무도 못 엽니다. 단, DB 백업과 **같은 곳에 두지 마세요.** 같이 새면 암호화한
# 의미가 없습니다.
DAENGS_JWE_KEY=
DAENGS_AES_KEY=
DAENGS_BLIND_INDEX_KEY=


# ── 카카오 소셜 로그인 ────────────────────────────────────────────────
# 앱이 보낸 id_token 의 `aud` 와 대조할 **앱 키 목록**입니다 —
# **"이 토큰이 우리 앱에게 발급된 것인가"**. 이 검사가 없으면 다른 카카오 앱에서
# 받은 토큰으로도 우리 서비스에 계정이 생깁니다 (D-017).
#
# **왜 하나가 아니라 목록인가.** 카카오는 인가 요청에 쓴 앱 키를 그대로 `aud` 에
# 넣습니다. 그래서 같은 애플리케이션이라도 들어온 경로마다 값이 다릅니다:
#
#     Android / iOS SDK   네이티브 앱 키     ← 앱 로그인
#     JavaScript SDK      JavaScript 키      ← 웹 로그인 (아직 없음)
#     REST API            REST API 키        ← uv run kakao-token
#
# 하나만 넣어 두면 나머지 경로가 통째로 401 이 됩니다. 콘솔의
# [내 애플리케이션 → 앱 설정 → 앱 키] 에 네 개가 함께 있습니다.
#
# ⚠ **한 애플리케이션의 키만 넣으세요.** 카카오 회원번호(sub)는 앱 단위라, 다른
#   애플리케이션의 키를 섞으면 같은 사람이 서로 다른 회원으로 갈라집니다.
# ⚠ **어드민 키는 넣지 마세요.** aud 로 오지 않고, 그 키 하나로 전 회원을 조작합니다.
#
# 비밀이 아닙니다 (앱에도 들어가 있습니다). 그래도 기본값을 두지 않습니다 —
# **비워 두면 aud 검증이 통째로 건너뛰어집니다** (joserfc 가 빈 목록이면 검사를
# 하지 않습니다). 그래서 비어 있으면 backend 가 뜨지 않습니다. 값은 JSON 배열입니다.
DAENGS_KAKAO_APP_KEYS=["<네이티브 앱 키>","<REST API 키>"]

# `uv run kakao-token` **전용**입니다. 로그인 검증에는 쓰이지 않습니다.
# 그 CLI 는 REST 흐름이라 client_id 자리에 REST API 키가 필요한데, 위 목록에서는
# 어느 것이 REST 키인지 알 수 없어서 한 줄 더 둡니다. `--client-id` 로 넘겨도 됩니다.
# 비워 두어도 backend 는 정상입니다.
#DAENGS_KAKAO_REST_API_KEY=


# ── 생활비서 RAG(①) · 실시간 산책(②) ─────────────────────────────────
# `daengs_life` 패키지가 읽는 값입니다 (D-018 로 이관). 발급처와 용도는
# docs/life/data-sources.md §9 · docs/life/realtime-apis.md.
#
# ⚠ **여기만 접두사가 없습니다.** 위 DAENGS_* 와 달리 이 이름들은 바꾸지 않았습니다:
#   · POSTGRES_* 는 최상단 .env 의 **compose 값을 그대로 읽습니다.** pgvector 컨테이너와
#     공유하는 이름이라 접두사를 붙이면 rag 가 DB 를 못 찾습니다.
#   · API 키는 발급 기관이 부르는 이름 그대로입니다 (docs/life/data-sources.md §9 와 1:1).
# 두 Settings 는 extra="ignore" 라 한 파일에 섞여 있어도 서로를 무시합니다.
#
# ⚠ DAENGS_KAKAO_APP_KEYS(위, 소셜 로그인 aud 검증)와 KAKAO_REST_KEY(아래, Local
#   주소 조회)는 **다른 용도**입니다. 같은 콘솔의 REST API 키를 양쪽에 넣어도 되지만
#   필드가 둘입니다. 위는 목록, 아래는 값 하나입니다.

# --- API 키 ---
# ⚠ DATA_GO_KR_KEY 는 포털이 Encoding / Decoding 두 벌로 보여줍니다. 맞는 것은 Decoding
#   쪽이고, Encoding 키를 넣으면 %2F → %252F 이중 인코딩으로 실패합니다
#   (realtime-apis.md §6.1 함정 1). 확인은 `uv run python -m daengs_life.realtime config`.
LAW_OC=
DATA_GO_KR_KEY=
KAKAO_REST_KEY=
SEOUL_OPEN_DATA_KEY=
KMA_HUB_KEY=

# --- LLM (생성·라우팅·Place 내부 discovery 공용 배포 값) ---
# 모델명을 상수로 안 박은 이유: 세대가 바뀌면 이름이 바뀌는데, 코드를 고치는 것과
# 이 한 줄을 고치는 것은 되돌리는 비용이 다릅니다 (RAG-028).
#
# ⚠ 개발 PC 에서 `uv run dev` 로 띄울 때 이 줄은 **시맨틱 라우터에만** 닿습니다.
# 훈련 RAG 의 생성부는 `os.environ` 만 읽어서(서버에서는 compose 의 env_file 이 올려
# 줍니다) 셸에 `$env:GEMINI_API_KEY` 를 따로 줘야 합니다. `uv run --env-file .env` 는
# 위 DAENGS_KAKAO_APP_KEYS 의 따옴표를 벗겨 기동이 죽으니 쓰지 마세요 — 루트
# README.md "트레이스를 LangSmith 로 보기".
GEMINI_API_KEY=
# 2026-08-27 부터 기본값은 gemini-3.1-flash-lite 입니다 (D-021). 9단계가 아직 관찰
# 단계라 체급보다 회전을 골랐고, 되돌리기가 이 한 줄이라 쌉니다.
# 실재하는 이름인지는 models.list() 로 확인하세요 — 세대가 바뀌면 옛 이름이 404 가 됩니다.
#GEMINI_MODEL=gemini-3.1-flash-lite
#
# Gemini 호출 타임아웃. ⚠ **밀리초입니다** (각 서비스가 SDK/HTTP timeout으로 변환).
# 30 을 넣으면 30밀리초가 되어 /ask 가 전부 504 가 됩니다. 이름에 _MS 가 붙은 이유입니다.
#GEMINI_TIMEOUT_MS=30000

# --- LLM judge (RAG-007 · D15) — 골든셋 채점 전용 ---
# ⚠ **일부러 다른 계열입니다.** 생성이 Gemini 인데 judge 도 Gemini 면 같은 훈련 계보가
# 자기 계열의 문장을 후하게 보는 self-preference 가 남습니다. RAG-007 이 요구한 것은
# "급 분리"(flash 생성 → pro judge)까지였는데, 2026-09-07 에 계열까지 가르기로 정했습니다.
#
# ⚠ **없어도 앱은 뜹니다.** 이 키는 `rag judge` 만 씁니다 — 채점 도구 하나 때문에
# /life/ask 가 죽으면 안 되므로 GEMINI_API_KEY 와 갈라 뒀습니다.
OPENAI_API_KEY=
# ⚠ **`-latest` 류를 쓰지 마세요.** 움직이는 이름이면 두 판정 파일의 차이가 답변 때문인지
# judge 때문인지 안 갈립니다. GEMINI_MODEL 과 방향이 반대인데, 그쪽은 생성이라 되돌리기가
# 싸고 이쪽은 **채점자**라 흔들리면 옛 판정과의 비교가 통째로 끊깁니다.
#OPENAI_JUDGE_MODEL=gpt-5.4-2026-03-05
# judge 호출 타임아웃. ⚠ **여기는 초입니다** (GEMINI_TIMEOUT_MS 와 단위가 다릅니다).
#OPENAI_TIMEOUT_S=120

# --- Place discovery 내부 호출 ---
# compose 안에서는 기본값(http://place-search:8000)을 그대로 씁니다. backend를 호스트에서
# 실행하면서 별도로 노출한 place-search를 붙일 때만 주소를 바꾸세요.
#DAENGS_PLACE_SEARCH_BASE_URL=http://127.0.0.1:8001
# assistant가 Place 전체 응답을 기다리는 독립 timeout (밀리초).
#DAENGS_PLACE_DISCOVERY_TIMEOUT_MS=15000

# 점령지 사진 VLM은 대화/라우팅과 별도 워커 예산을 씁니다. confirm 응답은 이 호출을
# 기다리지 않습니다. 12초 timeout + Celery 1회 재시도로 보통 30초 안에 종결 상태를
# 목표로 하며, 모델 교체 시 판정 행의 model_version에도 이름이 남습니다.
#TERRITORY_VISION_MODEL=gemini-3.1-flash-lite
#TERRITORY_VISION_TIMEOUT_MS=12000

# --- 캐시 (②) ---
# 실시간 산책의 값 캐시 · **일 예산 카운터** · 활성 키 집합이 여기 삽니다 (RT-001 ④).
#
# ⚠ DB 와 마찬가지로 **로컬이 아니라 서버 PC 의 Redis** 를 보게 하세요. 개발 PC 에
#   따로 띄우면 카운터가 갈려서, data.go.kr 의 일 1,000회 제약을 양쪽이 각자 세다가
#   실제로는 한도를 넘겨 부르게 됩니다. 주소·비밀번호는 최상단 .env 의
#   POSTGRES_IP / REDIS_PORT / REDIS_PASSWORD 와 맞추세요.
#
# ⚠ **URL 한 줄입니다.** 비밀번호에 @ / # 이 들어가면 깨집니다 — DAENGS_DB_* 를 조각으로
#   받는 이유(D-013)가 여기는 적용되지 않습니다. 최상단 .env.example 대로 영숫자로만.
#
# 서버 PC 의 컨테이너에서는 이 값을 쓰지 않습니다. compose 가 같은 이름으로
# redis://:<비번>@redis:6379/0 을 덮어씁니다 (DAENGS_DB_HOST 와 같은 방식).
#
# 비워 두거나 연결에 실패하면 프로세스 메모리로 떨어집니다 — "Redis 를 쓰되 없어도
# 돈다"(RT-001 ④-c). 앱은 그대로 뜨지만 예산 카운터가 재시작마다 리셋됩니다.
# 그 판단은 프로세스당 한 번뿐이라, 나중에 Redis 가 올라와도 저절로 붙지는 않습니다.
# ⚠ 비밀번호는 **`:` 뒤**입니다. 사용자 이름 자리(`//` 와 `:` 사이)는 비워 두세요 —
#   거기 넣으면 redis-py 가 ACL 사용자로 보내는데, --requirepass 만 건 서버에는
#   그런 사용자가 없어 인증에 실패합니다. 그리고 그 실패는 조용히 메모리 폴백입니다.
#     맞음  redis://:mypassword@192.168.0.22:6379/0
#     틀림  redis://mypassword@192.168.0.22:6379/0
REDIS_URL=redis://:<비밀번호>@192.168.0.22:6379/0

# 관리자 수동 크롤의 갈래 (#326). 집 서버는 비워 둔다(celery). GCP VM 에서만:
#DAENGS_CRAWL_BACKEND=cloudrun
#DAENGS_GCP_PROJECT=daengs
#DAENGS_GCP_REGION=asia-northeast3
#DAENGS_CORPUS_JOB=corpus-refresh

# --- 경로 override ---
# 레포 안에서 실행하면 `<레포>/data` 를 알아서 찾습니다. 지정하는 경우는 둘입니다.
#
# ⓐ **워크트리를 쓰면 지정하세요 — 이게 기본입니다.** `data/` 는 git 미추적이라(RAG-017)
#    워크트리 안에 따로 생기고 **워크트리를 지우면 코퍼스가 같이 지워집니다.** 실제로
#    조례 208건·보조금24 37건을 포함한 parsed 250건을 그렇게 잃었습니다 — 어느 PC 에도
#    남아 있지 않아 재수집으로만 복구됩니다. 개정되는 원문은 재수집이 곧 다른 코퍼스라
#    그건 복구가 아닙니다. 메인 체크아웃의 절대 경로로 고정해서 한 곳에만 쌓으세요.
#    (같은 `data/` 를 두 워크트리가 동시에 쓰면 부딪힙니다. 코퍼스를 통째로 잃는 것보다
#     싼 값이라 그렇게 둡니다 — 재파싱 중에 다른 쪽에서 pytest 를 돌리지만 마세요.)
#
# ⓑ 컨테이너처럼 레포 밖에서 돌릴 때. 이때는 볼륨을 붙입니다 (예: /data).
#    서버의 워커·Beat 가 그 형태입니다 — compose 가 `DAENGS_DATA_DIR=/data` 를 넣고 최상단
#    `.env` 의 `DAENGS_CORPUS_DIR` 을 거기에 마운트합니다 (RAG-050). 이 파일에는 안 적습니다.
#DAENGS_DATA_DIR=C:/Users/403/Documents/workspace/DAENGS_dev/data

# --- 임베딩 ---
# 서빙과 적재가 **같은 모델이어야 합니다.** 2026-08-27 에 판정 승자로 올렸습니다 (D-021) —
# 코퍼스를 0에서 다시 만드는 김에 재적재 비용이 사라졌기 때문입니다 (RAG-024).
# 교체는 이 한 줄이거나 `--model` 한 번입니다.
#
# ⚠ **어긋나면 조용히 틀립니다.** 문서 벡터와 질의 벡터가 다른 모델이면 두 벡터가 다른
#   공간에 있어 코사인이 무의미해지는데, 차원이 셋 다 1024 라 예외가 하나도 안 납니다.
#   그럴듯한 순위가 그냥 나옵니다. 기동 로그의 "임베딩 모델 불일치" 경고를 보세요.
#EMBEDDING_MODEL_KEY=qwen3-embedding-0.6b

# --- /ask 예열 ---
# 기동할 때 임베딩 모델(약 1.2GB)을 미리 올릴지. 기본 true 이고, 서버에서는 켜 두세요.
#
# 끄면 모델이 안 뜨는 게 아니라 **첫 /ask 요청이 로드를 뭅니다** (5~7초). 개발 PC 에서
# /ask 말고 다른 걸 보는 동안, 또는 ml 그룹을 깐 PC 에서 RAM 을 아끼고 싶을 때 끕니다.
# (테스트는 conftest.py 가 알아서 끕니다 — 안 끄면 실서버 DB 에까지 붙습니다.)
#DAENGS_WARM_UP_ENCODER=true

# ── 공용 파일 저장소 (D-043, D-052) ──────────────────────────────────
# 보행 영상만이 아닙니다 — 점령지 사진이 이미 같은 변수를 읽고, 프로필 사진·피부
# 사진·도감 카드가 같은 볼륨에 접두사로 들어옵니다 (D-052). 변수 이름이 GAIT_ 인 것은
# 보행에서 시작한 역사적 이름입니다.
#
# **저장 위치는 서버의 도커 볼륨입니다** (D-052). GCS 버킷은 파지 않습니다.
# 여기 기본값이 "none"(모든 저장 호출 503)인 것은 **개발 PC 가 아무 설정 없이도 뜨게**
# 하려는 것입니다 — 운영 서버는 최상단 `.env` 에서 켭니다(compose 가 읽는 자리, D-009).
#
#   none  (기본) — 미설정. /app/gait/analyze 가 503. 개발 PC 의 기본값.
#   local        — **운영값.** 서버의 gait-bridge 볼륨. bridge 엔드포인트를 지납니다.
#   gcs          — 지금은 안 씁니다. 서버가 부하를 못 받을 때 되돌아갈 길.
#GAIT_STORAGE=none

# local 일 때 (= 운영). 컨테이너 안 경로 + 앱이 부를 bridge URL 앞부분.
# 경로는 backend · gait-worker · territory-vision-worker 셋이 **같이 보는** 곳이어야 합니다.
#
# ⚠️ BASE_URL 은 **서버마다 다른 유일한 값**입니다. 집 서버는 아래 평문 http,
#    GCP VM 은 https://daengapi.weareithero.cloud 입니다. 릴리즈 앱이 보는 곳은
#    반드시 https 쪽이어야 합니다 (처리방침 6항이 HTTPS 를 공개해 뒀습니다).
#GAIT_LOCAL_STORAGE_DIR=/data/gait-bridge
#GAIT_BRIDGE_BASE_URL=http://daengback.weareithero.cloud

# bridge 업로드 한 건의 상한(바이트). 기본 150MB.
# D-052 로 모든 바이트가 backend 를 지나므로 이게 메모리 방어선입니다.
# nginx 의 client_max_body_size(200m) 보다 **낮게** 두세요.
#GAIT_MAX_UPLOAD_BYTES=157286400

# ── 보행 분석 엔진 (#304) ─────────────────────────────────────────────
# legacy = daengs_gait (ultralytics best.pt, 워커 venv). v4 = backend/gait_v4 (walk_demo v4,
# 별도 venv 를 서브프로세스로). **기본은 legacy** — ssdlite.pt 라이선스(academic/non-commercial)
# 결정 전이라 운영에서 v4 로 바꾸지 마세요. 두 엔진의 기록은 DB 에서 구분되지 않습니다.
#GAIT_ENGINE=legacy
# gait_v4 프로젝트 폴더. 비우면 저장소의 backend/gait_v4. 그 안의 .venv 와 weights/ 를 씁니다.
#GAIT_V4_DIR=
# v4 venv 의 python. 비우면 <GAIT_V4_DIR>/.venv/… . 컨테이너는 코드가 :ro 라 venv 를 /opt 에 두고 이걸로 알려 줍니다.
#GAIT_V4_PYTHON=

# gcs 로 되돌아갈 때만. **리전은 서울** (asia-northeast3) — 보호자 사진·영상이
# 개인정보라 해외 리전이면 국외이전 동의가 따로 필요합니다.
# 자격증명은 코드에 두지 않습니다 — GOOGLE_APPLICATION_CREDENTIALS 또는 워크로드 아이덴티티(ADC).
#GAIT_GCS_BUCKET=
#GAIT_GCS_LOCATION=asia-northeast3

# 만료(초). **아직 잠정값입니다** — 실기기 왕복을 보고 정합니다.
# ⚠️ local 에서는 다운로드 만료가 실제로 걸리지 않습니다 — bridge 주소에는 서명도
#    만료도 없고, 대신 라우터가 DB 로 "backend 가 발급한 키인지"를 봅니다.
#GAIT_UPLOAD_URL_TTL_SECONDS=900
#GAIT_DOWNLOAD_URL_TTL_SECONDS=600

# ── 내부 서비스 주소 (#180 상태 페이지) ──────────────────────────────
# 콘솔의 `/console/status` 가 "이 서비스가 살아 있나"를 물어보는 곳입니다.
# **기본값이 compose 서비스 이름이라 서버에서는 아무것도 안 적어도 됩니다.**
#
# 개발 PC 에서 `uv run dev` 로 띄우면 이 이름들이 애초에 안 풀리는데, 그것이 곧
# "이 환경엔 없다" 라서 상태 화면에 `absent`(고장 아님)로 뜹니다. 일부러 끄고 싶으면
# 빈 값으로 두세요 — 그러면 물어보지도 않습니다.
# place 는 위 DAENGS_PLACE_SEARCH_BASE_URL 을 그대로 씁니다 — 같은 컨테이너의 주소를
# 두 이름으로 두지 않습니다.
#DAENGS_JOURNEY_SERVICE_URL=http://journey-service:8000
# 보행(gait)은 주소가 아니라 Celery `gait` 큐의 워커 유무로 봅니다 (REDIS_URL 을 씀, D-063 4단계).

# 산책·점령 정책/통계: #260 및 activity migration/검증, 모든 writer 배포, 시즌 설정 뒤 활성화.
# 웹·사진 워커·activity 워커에 같은 값을 적용한다. 기본값 false.
# docs/activity-game-integration.md의 활성화·롤백 절차를 먼저 확인한다.
#DAENGS_ACTIVITY_GAME_ENABLED=false

# 기록 봉투: migration 적용 후 웹과 전용 워커에서 함께 활성화한다.
# docs/walk/entry-contexts.md의 적용·검증 절차를 따른다.
#DAENGS_WALK_ENTRY_CONTEXT_ENABLED=false

# SGIS 행정동 + 도시공원 배경. migration/verify_2026-09-09_walk_public_context.sql 적용 후 활성화.
# 웹과 기록 수집 워커에 같은 flag를 적용한다. 키와 캐시 경로는 서버 전용이다.
# docs/walk/public-context.md의 캐시 생성·공유·갱신 절차를 먼저 따른다.
#DAENGS_WALK_PUBLIC_CONTEXT_ENABLED=false
#DAENGS_WALK_SGIS_KEY=
#DAENGS_WALK_SGIS_SECRET=
#DAENGS_WALK_PUBLIC_DATA_KEY=
#DAENGS_WALK_PARK_CATALOG_PATH=
# Regional commerce/river catalogs; requires 28_walk_commerce_context.sql and public context.
#DAENGS_WALK_AREA_CONTEXT_ENABLED=false
#DAENGS_WALK_COMMERCE_CATALOG_PATH=
#DAENGS_WALK_RIVER_CATALOG_PATH=
#DAENGS_WALK_PUBLIC_CATALOG_ROOT=
#DAENGS_WALK_CATALOG_REFRESH_ENABLED=false
#DAENGS_WALK_CATALOG_DAILY_REQUESTS=300

# Apply 25_walk_entry_pins.sql before enabling reads. Keep reads on after any v2 write.
# Activate writes only after APP v2 compatibility and minimum-version rollout are verified.
#DAENGS_WALK_ENTRY_V2_ENABLED=false
#DAENGS_WALK_ENTRY_V2_WRITE_ENABLED=false
# Apply 26_walk_photo_manifests.sql + verifier before enabling photo metadata transport.
#DAENGS_WALK_PHOTO_METADATA_ENABLED=false
# 새 일기 형식을 요청하는 클라이언트 검증 뒤 활성화. 기본값은 false.
# 기존 Gemini 설정을 사용하며, 공개 생성은 bundle_format=walk-diary-bundle-v1을 명시한다.
#DAENGS_WALK_DIARY_ENABLED=false

# ── 피부 스크리닝 가중치를 허깅페이스에서 받기 ────────────────────────
# 채우면 `/models/release` 폴더 대신 여기서 받습니다. 비우면 예전 그대로입니다.
#
# ⚠️ **최상단 .env 가 아니라 여기입니다.** compose 의 `environment:` 에는 이 이름들이
#    없어서, 최상단에 적으면 컨테이너로 안 들어갑니다. 이 파일은 `env_file` 로
#    통째로 들어갑니다. 반대로 compose `environment:` 에 HF_TOKEN 을 추가하면
#    그쪽이 우선이라 **여기 값이 빈 값으로 덮입니다** (GEMINI_API_KEY 와 같은 함정).
#
# ⚠️ **개발서버와 GCP 둘 다** 넣어야 하고 값도 같아야 합니다 — 다르면 두 곳이
#    다른 모델로 도는데 응답은 양쪽 다 200 이라 눈으로는 안 보입니다.
#
# ⚠️ REVISION 을 비우지 마세요. 비면 `main` 을 따라가므로 리포에 푸시하는 순간
#    운영 모델이 바뀝니다 — PR 도 리뷰도 배포도 없이.
#
# 토큰은 그 리포만 읽는 fine-grained **Read** 로 만드세요. 쓰기 권한이 있는
# 토큰을 서버에 두면 서버가 모델을 덮어쓸 수 있습니다.
# 첫 요청 때 1.2GB 를 받습니다 (머신당 1회, hf-cache 볼륨에 남습니다).
SCREENING_RELEASE_REPO=
SCREENING_RELEASE_REVISION=
HF_TOKEN=

# 2단계 앙상블 팔 수. 안 맞으면 모델을 안 올리고 /screen/ 만 503 입니다.
# **비워 두세요** — REPO 가 설정돼 있으면 코드가 3 을 기본으로 씁니다.
# 다른 수의 릴리스로 시험할 때만 채우면 됩니다.
SCREENING_EXPECT_STAGE2_ARMS=
