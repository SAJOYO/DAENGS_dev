# docker-compose.yml 이 읽는 값입니다.
# 이 파일을 .env 로 복사해서 쓰세요.  Copy-Item .env.example .env
#
# ⚠ 서버 PC 전용입니다. compose 는 서버 PC 에서만 띄웁니다 — 개발 PC 에서는
# 이 파일이 필요 없습니다. 개발 PC 접속 정보는 backend/.env.example 을 보세요.
#
# backend 설정은 여기가 아니라 backend/.env 에 있습니다.

# ── Postgres (pgvector) ───────────────────────────────────────────
# ⚠ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 는 db/init/ 과 마찬가지로
#   **볼륨이 비어 있을 때 한 번만** 반영됩니다. 이미 만들어진 볼륨에서 이 값을
#   바꾸면 DB 안의 계정은 그대로라 backend 가 인증에 실패합니다.
#   이미 돌고 있는 DB 의 계정을 바꾸려면 psql 로 직접 하세요:
#     docker compose exec -it pgvector psql -U postgres
#     \password <계정>            (비밀번호 변경. 화면·히스토리에 안 남습니다)
#
# DB 가 있는 장비의 LAN IP. compose 가 읽는 값은 아니고, '팀 DB 가 어디인지'를
# 한 곳에 적어 두는 용도입니다. 개발 PC 에서 붙을 때 이 값을 backend/.env 의
# DAENGS_DB_HOST 에 넣으세요. 서버 PC 자신은 compose 네트워크로 붙으므로 안 씁니다.
POSTGRES_IP=
POSTGRES_USER=postgres
# 5432 를 LAN 에 열어 두는 구성이라 기본값을 그대로 쓰지 마세요.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vectordb
# 호스트에 노출할 포트. 이미 5432 를 쓰고 있으면 바꾸세요.
POSTGRES_PORT=5432

# ── pgAdmin (docker compose --profile tools up -d 일 때만) ────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
